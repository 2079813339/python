# ---- runtime mode ----
SATEMIS_ENV=dev
SATEMIS_DATA_SOURCE=synthetic        # synthetic | real
SATEMIS_DATA_ROOT=./data
SATEMIS_ARTIFACT_ROOT=./artifacts
SATEMIS_SEED=20261020

# ---- grid (single source of truth) ----
SATEMIS_GRID__LON_MIN=109.0
SATEMIS_GRID__LON_MAX=120.0
SATEMIS_GRID__LAT_MIN=29.0
SATEMIS_GRID__LAT_MAX=42.0
SATEMIS_GRID__RESOLUTION_DEG=0.1

# ---- storage ----
SATEMIS_STORAGE__BACKEND=local       # local | s3
SATEMIS_STORAGE__LOCAL_ROOT=./artifacts/store
SATEMIS_STORAGE__S3_ENDPOINT=localhost:9000
SATEMIS_STORAGE__S3_BUCKET=satemis
SATEMIS_STORAGE__S3_ACCESS_KEY=minioadmin
SATEMIS_STORAGE__S3_SECRET_KEY=minioadmin

# ---- database ----
SATEMIS_DB__URL=sqlite:///./artifacts/satemis.db

# ---- queue / cache ----
SATEMIS_REDIS__URL=redis://localhost:6379/0

# ---- auth ----
SATEMIS_AUTH__SECRET_KEY=dev-secret-change-me
SATEMIS_AUTH__ACCESS_TOKEN_MINUTES=720

# ---- api ----
SATEMIS_API__CORS_ORIGINS=["http://localhost:5173"]
SATEMIS_API__MAPBOX_TOKEN=

# ---- ml ----
SATEMIS_ML__N_TRIALS=0
SATEMIS_ML__MAX_TRAIN_ROWS=20000
